{%- assign raw_date = include.date | default: '' | strip -%}
{%- if raw_date == '' -%}
{%- elsif raw_date == 'present' or raw_date == 'Present' -%}
  present
{%- elsif raw_date contains '-' -%}
  {%- assign date_parts = raw_date | split: '-' -%}
  {%- assign year = date_parts[0] -%}
  {%- assign month = date_parts[1] | default: '' -%}
  {%- case month -%}
    {%- when '01' -%}
      Jan
    {%- when '02' -%}
      Feb
    {%- when '03' -%}
      Mar
    {%- when '04' -%}
      Apr
    {%- when '05' -%}
      May
    {%- when '06' -%}
      June
    {%- when '07' -%}
      July
    {%- when '08' -%}
      Aug
    {%- when '09' -%}
      Sept
    {%- when '10' -%}
      Oct
    {%- when '11' -%}
      Nov
    {%- when '12' -%}
      Dec
  {%- endcase -%}
  {%- if month != '' -%}
    {{- ' ' -}}
    {{- year -}}
  {%- else -%}
    {{- year -}}
  {%- endif -%}
{%- else -%}
  {{- raw_date -}}
{%- endif -%}
